; Run control
integrator               = md       
tinit                    = 0
dt                       = 0.004
nsteps                   = 400000000  ; 1600 ns

; Output control
nstxout                  = 400000
nstvout                  = 400000
nstlog                   = 40000
nstenergy                = 40000

; cutoffs
cutoff-scheme            = verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
rlist                    = 1.2
coulombtype              = PME ;cutoff  no charges
rcoulomb                 = 1.2
vdwtype                  = cutoff
rvdw                     = 1.2
DispCorr                 = EnerPres

; Temperature coupling
tcoupl			 = v-rescale
tc_grps                  = system
tau_t                    = 1.0
ref_t                    = 300

; Pressure coupling
Pcoupl                   = berendsen
tau_p                    = 50.0
compressibility          = 4.5e-05
ref_p                    = 1.0 

; bond constraints
;constraints              = none
constraint-algorithm     = lincs
